# ====================================================================
# IoT Firmware Security Analyzer - Environment Configuration Template
# ====================================================================
# Copy this file to .env and configure values for your environment.

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/iot_firmware"

# Server Ports & Paths
PORT=5000
BASE_PATH="/"

# CORS Allowed Origins (Comma-separated URLs for web frontend)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000"

# CVE Vulnerability Provider
# Options:
#   "circl" (Default) - CIRCL cve-search API (https://cve.circl.lu)
#   "nvd"             - National Vulnerability Database API 2.0 (https://nvd.nist.gov)
CVE_PROVIDER=circl

# Optional NVD API Key (Increases rate limit from 5 to 50 requests / 30s)
# NVD_API_KEY=""

# Maximum distinct software components to check for CVEs per scan (default 20)
MAX_COMPONENTS_PER_SCAN=20

# Node Environment
NODE_ENV="development"
